#!/bin/sh
# Load the local service account token for one command without changing the parent shell.
set +x
set -eu

if [ "$#" -eq 0 ]; then
  echo 'Usage: with-1password <command> [arguments...]' >&2
  exit 2
fi

if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  . "$HOME/.1password/.env"
fi

: "${OP_SERVICE_ACCOUNT_TOKEN:?Missing OP_SERVICE_ACCOUNT_TOKEN}"
export OP_SERVICE_ACCOUNT_TOKEN
exec "$@"
